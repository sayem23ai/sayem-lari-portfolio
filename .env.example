# Public browser configuration. Never put private secrets in VITE_ variables.
# Formspree's public form endpoint (optional). Without it, the form opens mailto.
VITE_FORMSPREE_ENDPOINT=
# Set to your final HTTPS deployment origin to enable canonical metadata.
VITE_SITE_URL=
# Original generated chiptune is included. To replace it, add a licensed MP3
# at public/audio/background-theme.mp3 and set this URL accordingly.
VITE_MUSIC_URL=/audio/background-theme.wav
